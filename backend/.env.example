# ──────────────────────────────────────────────
#  Edge-AI Acoustic Backend — Environment Config
# ──────────────────────────────────────────────

# Express server port
PORT=3000

# Supabase project credentials (service role key — server-side ONLY, never expose to frontend)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# MQTT broker connection
MQTT_BROKER_URL=mqtt://broker.hivemq.com:1883
MQTT_TOPIC=edge-ai/events

# Admin API key for destructive operations (DELETE /api/events)
ADMIN_API_KEY=your-secret-admin-key-here
